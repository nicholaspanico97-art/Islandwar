{
  // Items, what each block gives when mined, and recipes: the Stone and Bronze Ages so far. What's locked
  // behind research is in techs.json.
  // How many items a player can carry, of any mix.
  "backpack_capacity": 40,
  // The server allows a mine this much faster than the block's hardness, for network timing.
  "mining_slack_seconds": 0.25,
  // Taking a whole structure down by hand takes this long.
  "structure_hardness": 1.5,

  // places: the block an item puts down when placed from the hotbar (none for raw materials).
  // tool: what it mines with. A tool of the right kind and at least the block's tier is needed for blocks
  // that have a tier, and divides every matching block's hardness by its speed. The best one carried is
  // used; tools don't wear out (yet).
  "items": [
    { "id": "log", "name": "Log", "color": "#5c4024", "places": "wood" },
    { "id": "planks", "name": "Planks", "color": "#b88c54", "places": "planks" },
    { "id": "stone", "name": "Stone", "color": "#808085", "places": "stone" },
    { "id": "dirt", "name": "Dirt", "color": "#785436", "places": "dirt" },
    { "id": "sand", "name": "Sand", "color": "#dbcc91", "places": "sand" },
    { "id": "clay", "name": "Clay", "color": "#9ea3b3" },
    { "id": "copper_ore", "name": "Copper ore", "color": "#cd783c" },
    { "id": "tin_ore", "name": "Tin ore", "color": "#bec3cd" },
    { "id": "iron_ore", "name": "Iron ore", "color": "#a06c5c" },
    { "id": "coal", "name": "Coal", "color": "#28282a" },
    { "id": "charcoal", "name": "Charcoal", "color": "#3a3230" },
    { "id": "copper_ingot", "name": "Copper ingot", "color": "#d9824a" },
    { "id": "tin_ingot", "name": "Tin ingot", "color": "#d0d4dc" },
    { "id": "bronze_ingot", "name": "Bronze ingot", "color": "#b5833a" },
    { "id": "stone_axe", "name": "Stone axe", "color": "#8a7a66", "tool": { "kind": "axe", "tier": 1, "speed": 2.5 } },
    { "id": "stone_pickaxe", "name": "Stone pickaxe", "color": "#7d7d88", "tool": { "kind": "pickaxe", "tier": 1, "speed": 2.0 } },
    { "id": "bronze_axe", "name": "Bronze axe", "color": "#a87a3c", "tool": { "kind": "axe", "tier": 2, "speed": 3.5 } },
    { "id": "bow", "name": "Bow", "color": "#8a5a2b" },
    { "id": "arrow", "name": "Arrow", "color": "#c8c0a8" },
    { "id": "bronze_pickaxe", "name": "Bronze pickaxe", "color": "#9c7034", "tool": { "kind": "pickaxe", "tier": 2, "speed": 3.0 } },
    { "id": "iron_ingot", "name": "Iron ingot", "color": "#8e9399" },
    { "id": "iron_axe", "name": "Iron axe", "color": "#7c8288", "tool": { "kind": "axe", "tier": 3, "speed": 4.5 } },
    { "id": "iron_pickaxe", "name": "Iron pickaxe", "color": "#737a82", "tool": { "kind": "pickaxe", "tier": 3, "speed": 4.0 } },
  ],

  // Every natural or placeable block: seconds to mine by hand, the item it drops (none for leaves), the
  // tool that speeds it up, and the tier of that tool it needs (0 or none: bare hands will do).
  "blocks": {
    "stone": { "hardness": 1.5, "drops": "stone", "tool": "pickaxe" },
    "dirt": { "hardness": 0.5, "drops": "dirt" },
    "grass": { "hardness": 0.6, "drops": "dirt" },
    "sand": { "hardness": 0.5, "drops": "sand" },
    "planks": { "hardness": 1.0, "drops": "planks", "tool": "axe" },
    "wood": { "hardness": 2.0, "drops": "log", "tool": "axe" },
    "leaves": { "hardness": 0.2 },
    "copper_ore": { "hardness": 3.0, "drops": "copper_ore", "tool": "pickaxe", "tier": 1 },
    "tin_ore": { "hardness": 3.0, "drops": "tin_ore", "tool": "pickaxe", "tier": 1 },
    // Iron needs a better pickaxe than stone: the Bronze Age's.
    "iron_ore": { "hardness": 4.0, "drops": "iron_ore", "tool": "pickaxe", "tier": 2 },
    "coal": { "hardness": 2.5, "drops": "coal", "tool": "pickaxe", "tier": 1 },
    "clay": { "hardness": 0.8, "drops": "clay" },
  },

  // station: "hand" (crafting window, C) or a structure kind (open it with E). Ingredients come from the
  // backpack first, then the team's storage; the result goes into the backpack.
  "recipes": [
    { "id": "planks", "station": "hand", "takes": { "log": 1 }, "makes": { "planks": 4 } },
    { "id": "stone_axe", "station": "workbench", "takes": { "stone": 3, "planks": 2 }, "makes": { "stone_axe": 1 } },
    { "id": "stone_pickaxe", "station": "workbench", "takes": { "stone": 3, "planks": 2 }, "makes": { "stone_pickaxe": 1 } },
    { "id": "bow", "station": "workbench", "takes": { "planks": 3, "log": 1 }, "makes": { "bow": 1 } },
    { "id": "arrows", "station": "workbench", "takes": { "planks": 1, "stone": 1 }, "makes": { "arrow": 4 } },
    { "id": "bronze_axe", "station": "workbench", "takes": { "bronze_ingot": 3, "planks": 2 }, "makes": { "bronze_axe": 1 } },
    { "id": "bronze_pickaxe", "station": "workbench", "takes": { "bronze_ingot": 3, "planks": 2 }, "makes": { "bronze_pickaxe": 1 } },
    { "id": "iron_axe", "station": "workbench", "takes": { "iron_ingot": 3, "planks": 2 }, "makes": { "iron_axe": 1 } },
    { "id": "iron_pickaxe", "station": "workbench", "takes": { "iron_ingot": 3, "planks": 2 }, "makes": { "iron_pickaxe": 1 } },
  ],

  // Heat (furnaces). Temperatures in degrees C; a cold furnace is at ambient_temperature.
  "ambient_temperature": 20,

  // What burns in a furnace. seconds: how long one item burns flat out. heat: degrees per second it adds to a
  // furnace at 100% efficiency (the furnace's efficiency takes its share). flame: the hottest it can make a
  // furnace. Once a furnace is as hot as it can get, fuel only burns as fast as needed to make up lost heat.
  "fuel": {
    "log": { "seconds": 15, "heat": 70, "flame": 950 },
    "planks": { "seconds": 5, "heat": 60, "flame": 900 },
    "charcoal": { "seconds": 30, "heat": 150, "flame": 1700 },
    "coal": { "seconds": 40, "heat": 170, "flame": 1900 },
  },

  // What a furnace makes: once its two input slots hold everything a recipe takes and the furnace is at least
  // temperature degrees C, that many turn into count of what it makes after seconds (paused, not lost, while it's
  // too cold). An item goes into one recipe at most; recipes are tried in this order. smelters: the only
  // structures that can make it (any furnace if left out).
  "smelting": [
    { "takes": { "copper_ore": 1 }, "makes": "copper_ingot", "seconds": 5, "temperature": 1100 },
    { "takes": { "tin_ore": 1 }, "makes": "tin_ingot", "seconds": 5, "temperature": 900 },
    { "takes": { "log": 1 }, "makes": "charcoal", "seconds": 8, "temperature": 300 },
    // Bronze: three parts copper to one of tin.
    { "takes": { "copper_ingot": 3, "tin_ingot": 1 }, "makes": "bronze_ingot", "count": 4, "seconds": 10, "temperature": 1000 },
    // Iron needs more heat than an ordinary furnace can make: a blast furnace (the step into the Iron Age).
    { "takes": { "iron_ore": 1 }, "makes": "iron_ingot", "seconds": 8, "temperature": 1500 },
  ]
}
