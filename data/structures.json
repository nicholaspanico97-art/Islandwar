{
  // Kinds of structure players can place. Stone Age first pass, until the developer's tech tree.
  // size is in blocks along x, y (up) and z, before turning; turning 90 degrees swaps x and z.
  // color is how clients draw it until there are models.
  // capacity: how many items it stores (any mix). Stored items belong to the team and are lost with it.
  // cost: what building one takes. In a real match placing one puts down its blueprint for free; players
  // then carry the cost to it from their backpacks (E on it) and it's built when nothing is missing. A
  // blueprint does nothing (stores, smelts, crafts nothing) and has a quarter of the health. Taking one down
  // by hand gives back what was delivered (a built one, its whole cost), as much as fits in the backpack; a
  // destroyed one gives nothing. In creative presets structures are built at once.
  "kinds": [
    { "id": "crate", "name": "Crate", "size": { "x": 1, "y": 1, "z": 1 }, "max_health": 60, "color": "#a07444", "capacity": 200,
      "cost": { "planks": 6 } },
    // Builds ships (Shipbuilding research). Place it at the shore facing the sea: the water in front of its
    // far end (the slip, as long as the ship and a little wider) must be open water. Once it's built, E on it
    // delivers what its ship needs, and the ship is launched into the slip when nothing is missing.
    { "id": "dock", "name": "Dock", "size": { "x": 3, "y": 1, "z": 6 }, "max_health": 150, "color": "#8a6a44",
      "cost": { "planks": 20 }, "dock": { "ships": ["galley"] } },
    { "id": "depot", "name": "Depot", "size": { "x": 3, "y": 2, "z": 3 }, "max_health": 200, "color": "#5d6670", "capacity": 1000,
      "cost": { "planks": 12, "stone": 20 } },
    // Smelts ore into ingots (and logs into charcoal) over time while fuel burns. Open it with E. Each of its
    // three slots (to smelt, fuel, done) holds up to slot_capacity items; what's in it is lost if destroyed.
    { "id": "furnace", "name": "Furnace", "size": { "x": 1, "y": 2, "z": 1 }, "max_health": 120, "color": "#6b5f58",
      "cost": { "stone": 12, "clay": 4 }, "smelter": { "slot_capacity": 32 } },
    // The Bronze Age's last step (Blast furnace research): a bigger furnace, the only one hot enough for
    // iron. Built by blueprint; a team that has researched it and built one enters the Iron Age. A single
    // structure for now (a multiblock build may come later).
    { "id": "blast_furnace", "name": "Blast furnace", "size": { "x": 2, "y": 3, "z": 2 }, "max_health": 300, "color": "#4f4440",
      "cost": { "stone": 30, "clay": 10, "bronze_ingot": 4 }, "smelter": { "slot_capacity": 48 } },
    // What a player was carrying, left where they died. Anyone can open it (E) and take from it; nothing goes
    // in, and it disappears once empty. Not placeable by players (loot).
    { "id": "dropped_backpack", "name": "Dropped backpack", "size": { "x": 1, "y": 1, "z": 1 }, "max_health": 30, "color": "#6e4b2a",
      "capacity": 40, "loot": true },
    // Crafting station for tools (open it with E).
    { "id": "workbench", "name": "Workbench", "size": { "x": 2, "y": 1, "z": 1 }, "max_health": 80, "color": "#8c6a3c",
      "cost": { "planks": 4 } },
  ],

  // Ships, built at a dock. One player sails one (W row, S back water, A/D turn, E to get out onto the
  // nearest land or dock). Speeds in blocks per second, turn_rate in radians per second; width is the beam
  // and the collision box's side, length is for drawing and the slip.
  "ships": [
    { "id": "galley", "name": "Galley", "cost": { "planks": 30, "log": 6, "bronze_ingot": 2 },
      "max_speed": 7.0, "reverse_speed": 2.0, "acceleration": 2.5, "turn_rate": 0.6,
      "width": 3.0, "length": 9.0, "height": 2.0, "enter_distance": 6.0, "color": "#7a5230" },
  ],
}
