{
  // Match presets (game plan: both are real modes). Pick one with the server's --preset=NAME.
  // Times are in minutes unless the name says seconds.
  // Real matches go by eras: each team researches its way forward (techs.json), and planes and bombs wait for
  // WWI, the nuke for the Cold War. Creative presets (practice and tests) have everything and keep the old
  // timed phases instead: phase 1 runs from the start to phase2_start_minutes, crater_radius_by_phase is the
  // bomb crater radius in phases 1, 2, 3 (0 = no bombs) and each team gets a nuke when phase 3 starts.
  // nuke_cooldown_minutes: another nuke this long after each drop.
  "compressed": {
    // 4v4, about 45 minutes. The default. (The eras' average times add up to far more: to balance.)
    "max_players_per_team": 4,
    "max_team_imbalance": 1,
    "min_players_per_team": 1,
    "countdown_seconds": 10,
    "time_limit_minutes": 45,
    "results_seconds": 20,
    "nuke_cooldown_minutes": 4
  },
  "full": {
    // 12v12, about 3 hours. (The eras' average times add up to about 3 h 45 min: to balance.)
    "max_players_per_team": 12,
    "max_team_imbalance": 1,
    "min_players_per_team": 2,
    "countdown_seconds": 20,
    "time_limit_minutes": 180,
    "results_seconds": 30,
    "nuke_cooldown_minutes": 10
  },
  "quick": {
    // Half an hour: long enough for the Stone Age and into the Bronze Age, for demos and short playtests.
    "max_players_per_team": 4,
    "max_team_imbalance": 1,
    "min_players_per_team": 1,
    "countdown_seconds": 10,
    "time_limit_minutes": 30,
    "results_seconds": 15,
    "nuke_cooldown_minutes": 0.5
  },
  "bronze": {
    // Playtesting the Bronze Age without the Stone Age first. Real rules (gathering, blueprints, research),
    // but it never starts a match (endless warmup). Each team starts in the Bronze Age with its basic techs
    // and points for Shipbuilding and the Blast furnace (and Smithing once in the Iron Age); each player with
    // bronze tools and a bow; each team with a stocked depot a few blocks from its spawn.
    "max_players_per_team": 12,
    "max_team_imbalance": 12,
    "min_players_per_team": 1000,
    "countdown_seconds": 10,
    "time_limit_minutes": 30,
    "results_seconds": 10,
    "nuke_cooldown_minutes": 1,
    "start_research": ["mining", "logging", "smelting", "bronze_working", "bronze_tools", "archery", "fortification", "prospecting"],
    "start_points": { "bronze": 60, "iron": 30 },
    "start_backpack": { "bronze_pickaxe": 1, "bronze_axe": 1, "bow": 1, "arrow": 12 },
    "start_depot": { "planks": 200, "log": 60, "stone": 150, "clay": 40, "bronze_ingot": 30, "iron_ore": 20, "charcoal": 40,
                     "copper_ingot": 12, "tin_ingot": 4 }
  },
  "phases": {
    // The old quick match, creative: five minutes with timed phases, bombs and the nuke, to try them by hand.
    "creative": true,
    "max_players_per_team": 4,
    "max_team_imbalance": 1,
    "min_players_per_team": 1,
    "countdown_seconds": 10,
    "phase2_start_minutes": 1,
    "phase3_start_minutes": 3,
    "time_limit_minutes": 5,
    "results_seconds": 15,
    "crater_radius_by_phase": [0, 3, 5],
    "nuke_cooldown_minutes": 0.5
  },
  "practice": {
    // Never starts a match: endless warmup with everything allowed. The bot sync test uses it.
    "creative": true,
    "max_players_per_team": 12,
    "max_team_imbalance": 12,
    "min_players_per_team": 1000,
    "countdown_seconds": 10,
    "phase2_start_minutes": 1,
    "phase3_start_minutes": 2,
    "time_limit_minutes": 3,
    "results_seconds": 10,
    "crater_radius_by_phase": [4, 4, 4],
    "nuke_cooldown_minutes": 1
  },
  "test": {
    // A whole match in about 20 seconds, for the automated match test.
    "creative": true,
    "max_players_per_team": 4,
    "max_team_imbalance": 1,
    "min_players_per_team": 1,
    "countdown_seconds": 3,
    "phase2_start_minutes": 0.1,
    "phase3_start_minutes": 0.2,
    "time_limit_minutes": 0.3,
    "results_seconds": 4,
    "crater_radius_by_phase": [0, 2, 3],
    "nuke_cooldown_minutes": 0.05
  },
  "nuketest": {
    // Phase 3 (and the nuke) after 3 seconds, for the automated nuke test.
    "creative": true,
    "max_players_per_team": 4,
    "max_team_imbalance": 1,
    "min_players_per_team": 1,
    "countdown_seconds": 3,
    "phase2_start_minutes": 0.02,
    "phase3_start_minutes": 0.05,
    "time_limit_minutes": 3,
    "results_seconds": 10,
    "crater_radius_by_phase": [0, 3, 5],
    "nuke_cooldown_minutes": 1
  }
}
